NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Generic OpenAI-compatible provider config. Use this for 云雾 API.
AI_BASE_URL="https://yunwu.ai/v1"
AI_API_KEY="your_token_here"
AI_MODEL="gemini-3.1-flash-lite"
TRANSCRIBE_MODEL="gpt-4o-transcribe"

# Digital human video generation through 云雾 API.
DIGITAL_HUMAN_PROVIDER="yunwu"
DIGITAL_HUMAN_MODEL="kling-avatar-image2video"
DIGITAL_HUMAN_ENDPOINT="/kling/v1/videos/avatar/image2video"
SPEECH_MODEL="speech-02-turbo"
SPEECH_ENDPOINT="/minimax/v1/t2a_v2"
SPEECH_VOICE="Chinese (Mandarin)_Warm_Girl"
HEYGEN_API_KEY=""
HEYGEN_VOICE_ID=""

# WeChat Pay. Required before real WeChat payments can be created.
WECHAT_PAY_APP_ID=""
WECHAT_PAY_MCH_ID=""
WECHAT_PAY_API_V3_KEY=""
WECHAT_PAY_PRIVATE_KEY=""
WECHAT_PAY_CERT_SERIAL_NO=""
WECHAT_PAY_NOTIFY_URL=""

# Alipay. Required before real Alipay payments can be created.
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_NOTIFY_URL=""
ALIPAY_RETURN_URL=""

# Models shown in the app are configured in lib/models.ts.
# Add or remove provider-supported model ids there.

# Optional direct OpenAI config. Used only when AI_API_KEY is empty.
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Keep empty while running demo mode without database.
DATABASE_URL=""

# Optional: enable Google login after creating OAuth credentials.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
